# ==========================================
# Neurova AI Backend Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="Neurova AI"
SECRET_KEY="super-secret-jwt-key-for-neurova-ai-2026-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL in production, SQLite fallback in local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/neurova_ai_db"

# Google Gemini LLM API Key (For adaptive AI question generation & resume parsing)
GEMINI_API_KEY="your-gemini-api-key-here"

# Real-time Email Notification Gateway (SMTP)
# For Gmail: Use smtp.gmail.com with a 16-character App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-character-app-password"
SENDER_EMAIL="your-email@gmail.com"
